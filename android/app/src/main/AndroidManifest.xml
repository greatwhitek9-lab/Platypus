<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Required to act as a USB host (phone/tablet side of an OTG cable). -->
    <uses-feature android:name="android.hardware.usb.host" android:required="true" />

    <!-- Lets the automated capture pipeline keep running as a foreground
         service while the screen is off or the app is backgrounded. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.AppCompat.DayNight.NoActionBar">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Auto-launch when the dongle is plugged in via OTG, on any
                 Android device/OEM skin (Samsung One UI included) that
                 honors this standard USB-attach intent filter. -->
            <intent-filter>
                <action android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED" />
            </intent-filter>
            <meta-data
                android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED"
                android:resource="@xml/device_filter" />
        </activity>

        <!-- Runs the automated connect/handshake/capture chain
             (DongleController) regardless of whether MainActivity is
             visible, so capture never stops just because the screen
             locked or the user switched apps. -->
        <service
            android:name=".DongleService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice" />
    </application>
</manifest>
